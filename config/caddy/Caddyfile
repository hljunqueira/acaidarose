# Caddyfile para Açaí da Rose — SSL Let's Encrypt Automático

api.acaidarose.pt {
    # Redireciona para o backend na porta local
    respond "Açaí da Rose API Gateway Online" 200
}

# Webmail Corporativo e Autoconfiguração de Clientes de E-mail (iOS, Android, Thunderbird, Outlook)
mail.acaidarose.pt, autoconfig.acaidarose.pt, autodiscover.acaidarose.pt {
    reverse_proxy mailserver:80 {
        header_up X-Forwarded-Host {host}
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }
}
