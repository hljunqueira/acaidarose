// ============================================================
// Açaí da Rose — Schema Prisma (Design Artifact)
// Multi-tenant PDV / Motor de Montagem de Açaí (PT-PT)
// PostgreSQL + Prisma ORM
// ============================================================
// NOTA: Este ficheiro é o artefato de arquitetura pedido.
// A camada de persistência de runtime deste MVP usa a stack
// disponível no container (MongoDB via /api routes) para dar
// o aha-moment do Wizard rapidamente. A modelagem aqui
// representa fielmente o desenho relacional recomendado para
// produção em Postgres.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------
// Enums
// -------------------------
enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  CASHIER
}

enum OrderStatus {
  OPEN
  PAID
  CANCELLED
}

// Pagamento estritamente informacional — sem tokens/gateways
enum PaymentMethod {
  NUMERARIO
  MULTIBANCO
  MB_WAY
  PLATAFORMA
}

// -------------------------
// Núcleo Multi-tenant
// -------------------------
model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  nif         String?  // Número de Identificação Fiscal (PT)
  address     String?
  phone       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  users       User[]
  containers  ProductContainer[]
  bases       ProductBase[]
  toppings    ProductTopping[]
  orders      Order[]
  auditLogs   AuditLog[]

  @@index([slug])
  @@index([deletedAt])
}

model User {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  email      String   @unique
  name       String
  password   String   // hash bcrypt/argon2
  role       Role     @default(CASHIER)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  orders     Order[]
  auditLogs  AuditLog[]

  @@index([tenantId])
  @@index([email])
  @@index([deletedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String?
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String   // e.g. "ORDER_CREATED", "USER_LOGIN"
  entity     String   // e.g. "Order", "User"
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([entity, entityId])
}

// -------------------------
// Motor de Açaí — Catálogo
// -------------------------
model ProductContainer {
  id                       String   @id @default(uuid())
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [id])
  name                     String   // ex: "Copo 300ml", "Taça Família"
  precoBase                Decimal  @db.Decimal(10, 2)
  limiteBases              Int      @default(1)
  limiteComplementosGratis Int      @default(3)
  active                   Boolean  @default(true)
  displayOrder             Int      @default(0)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  deletedAt                DateTime?

  orderItems               OrderItem[]

  @@index([tenantId, active])
  @@index([deletedAt])
}

model ProductBase {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String   // ex: "Açaí Tradicional", "Açaí c/ Banana"
  description  String?
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  orderItemBases OrderItemBase[]

  @@index([tenantId, active])
  @@index([deletedAt])
}

model ProductTopping {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String   // ex: "Granola", "Morango", "Nutella"
  category     String?  // ex: "Frutas", "Doces", "Cereais"
  isPremium    Boolean  @default(false)
  precoExtra   Decimal  @db.Decimal(10, 2) @default(0)
  active       Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  orderItemToppings OrderItemTopping[]

  @@index([tenantId, active])
  @@index([deletedAt])
}

// -------------------------
// Vendas
// -------------------------
model Order {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  cashierId     String?
  cashier       User?         @relation(fields: [cashierId], references: [id])
  orderNumber   Int           // sequencial diário por tenant (gerado em transação)
  subtotal      Decimal       @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  status        OrderStatus   @default(PAID)
  paymentMethod PaymentMethod // apenas registo — sem token, sem webhook
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  items         OrderItem[]

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([deletedAt])
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  containerId     String
  container       ProductContainer @relation(fields: [containerId], references: [id])
  containerName   String   // snapshot
  containerPrice  Decimal  @db.Decimal(10, 2) // snapshot
  freeToppingsAllowed Int  // snapshot do limite grátis no momento da venda
  extraTotal      Decimal  @db.Decimal(10, 2) @default(0) // soma dos toppings pagos
  lineTotal       Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now())

  bases           OrderItemBase[]
  toppings        OrderItemTopping[]

  @@index([orderId])
}

model OrderItemBase {
  id          String   @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  baseId      String
  base        ProductBase @relation(fields: [baseId], references: [id])
  baseName    String   // snapshot

  @@index([orderItemId])
}

model OrderItemTopping {
  id          String   @id @default(uuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  toppingId   String
  topping     ProductTopping @relation(fields: [toppingId], references: [id])
  toppingName String   // snapshot
  isPremium   Boolean  // snapshot
  isPaid      Boolean  // true = passou do limite grátis / é premium
  precoCobrado Decimal @db.Decimal(10, 2) @default(0) // 0 quando foi grátis

  @@index([orderItemId])
  @@index([toppingId])
}
